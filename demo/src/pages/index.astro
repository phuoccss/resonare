---
import { ThemeSelect as ReactThemeSelect } from '../integration/theme-select-react'
import { ThemeSelect as SolidThemeSelect } from '../integration/theme-select-solid'
import SvelteThemeSelect from '../integration/theme-select-svelte.svelte'
import VueThemeSelect from '../integration/theme-select-vue.vue'
import { themeScript } from '../integration/shared'
import './_style.css'
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width,initial-scale=1'
    />
    <title>Resonare Demo</title>
    <meta
      name='content'
      content='#fff'
      media='(prefers-color-scheme: light)'
    />
    <meta
      name='content'
      content='#000'
      media='(prefers-color-scheme: dark)'
    />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <main>
      <h1>resonare</h1>
      <h2>A state store for multi-dimensional themes and user preferences.</h2>
      <a
        href='https://github.com/phuoccss/resonare'
        rel='noopener noreferrer'
        target='_blank'
      >
        Documentation <span aria-hidden='true'>→</span>
      </a>
      <div class='frameworks'>
        <section
          class='framework'
          id='react'
        >
          <h3>React</h3>
          <ReactThemeSelect client:load />
        </section>
        <section
          class='framework'
          id='solid'
        >
          <h3>Solid</h3>
          <SolidThemeSelect client:load />
        </section>
        <section
          class='framework'
          id='svelte'
        >
          <h3>Svelte</h3>
          <SvelteThemeSelect client:load />
        </section>
        <section
          class='framework'
          id='vue'
        >
          <h3>Vue</h3>
          <VueThemeSelect client:load />
        </section>
      </div>
    </main>
  </body>
</html>
